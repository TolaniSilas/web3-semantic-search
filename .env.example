# Required: Groq API key for LLM and vision (image description, tags, query expansion).
# Get one at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Optional: ChromaDB persistence directory (default: ./chroma_data).
# Ignored if using Chroma Cloud.
CHROMA_DIR=./chroma_data

# Optional: Chroma API key for Chroma Cloud storage.
# Get one at https://www.trychroma.com/ - only needed when using cloud instead of local.
# CHROMA_API_KEY=your_chroma_api_key_here
